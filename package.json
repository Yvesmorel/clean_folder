{
  "name": "clean-folder-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean_folder — local, review-first desktop file organization",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sidecar:bundle": "node scripts/build-sidecar.mjs --bundle-only",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "desktop:dev": "npm run sidecar:build && tauri dev",
    "desktop:build": "npm run sidecar:build && tauri build",
    "tauri": "tauri",
    "test": "node --test test/*.test.mjs",
    "dev:browser": "node scripts/browser-dev.mjs",
    "test:ui": "node scripts/test-ui.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@yao-pkg/pkg": "6.23.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.27.0",
    "playwright": "^1.58.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "8.3.4"
  }
}
